# InkTime 环境变量模板（复制为 .env 并填写）
# 本机直接用 config.py 跑时，可 source 这个文件加载变量
# Docker 部署时，把这些值填进 docker-compose.yml 的环境变量区

# MiniMax API key（视觉打分用；README 里也提到）
MINIMAX_API_KEY=your-minimax-key-here

# 照片库路径（Docker 里 = /app/photos）
INKTIME_IMAGE_DIR=/app/photos

# 数据库 + 输出目录（Docker 里持久化到 ./data）
INKTIME_DB_PATH=/app/data/photos.db
INKTIME_BIN_OUTPUT_DIR=/app/data/output

# 时区
TZ=Asia/Shanghai

# 每日渲染 cron 表达式
RENDER_CRON=5 4 * * *
